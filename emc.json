{
    "enhConfig": {
        "enhKey": "beTyped",
        "spawn": "be-typed/be-typed.js",
        "withAttrs": {
            "base": "be-typed",
            "triggerInsertPosition": "${base}-trigger-insert-position",
            "labelTextContainer": "${base}-label-text-container",
            "buttonContent": "${base}-button-content",
            "_nudge": {
                "instanceOf": "Boolean"
            }
        }
    },
    "customData": {
        "weakRef": {
            "properties": [
                "enhancedElement",
                "trigger"
            ]
        },
        "actions": {
            "addTypeBtn": {
                "ifAllOf": [
                    "triggerInsertPosition",
                    "enhancedElement"
                ]
            },
            "setBtnContent": {
                "ifAllOf": [
                    "buttonContent",
                    "trigger"
                ],
                "ifNoneOf": [
                    "byob"
                ]
            }
        },
        "handlers": {
            "trigger_to_openDialog_on": "click"
        },
        "propagate": [
            "labelTextContainer"
        ],
        "defaultPropVals": {
            "byob": true,
            "triggerInsertPosition": "beforeend",
            "labelTextContainer": "span",
            "buttonContent": "⚙️"
        }
    }
}
